# ============================================================
# SentinelRAG — Environment Configuration Example
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.
# ============================================================

# ---------------------------
# App / Server Config
# ---------------------------
APP_ENV=development                 # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info                      # debug | info | warning | error

# ---------------------------
# Storage Paths
# ---------------------------
VIDEO_STORAGE_PATH=./data/videos
THUMBNAIL_STORAGE_PATH=./data/thumbnails
FRAME_CACHE_PATH=./data/frames

# ---------------------------
# Frame Sampling Config
# ---------------------------
FRAME_SAMPLE_INTERVAL_SECONDS=1.5   # or use scene-change detection instead
USE_SCENE_CHANGE_DETECTION=false

# ---------------------------
# Object Detection (YOLO11)
# ---------------------------
YOLO_MODEL_NAME=yolo11n.pt          # yolo11n/s/m/l/x depending on speed/accuracy tradeoff
YOLO_CONFIDENCE_THRESHOLD=0.4
YOLO_DEVICE=cuda                    # cuda | cpu | mps

# ---------------------------
# Captioning (Vision-Language Model)
# ---------------------------
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
VLM_INFERENCE_MODE=local            # local | api
VLM_INFERENCE_ENDPOINT=             # e.g. http://localhost:8001/v1 if self-hosting via vLLM
VLM_USE_RULE_BASED_FALLBACK=true    # falls back to template captions if VLM unavailable

# Hugging Face token — required to download gated/rate-limited model weights
HUGGINGFACE_TOKEN=

# ---------------------------
# Embeddings (for ChromaDB indexing + query)
# ---------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ---------------------------
# Vector Database (ChromaDB)
# ---------------------------
CHROMA_MODE=local                   # local (persistent client) | server
CHROMA_DB_PATH=./data/chroma
CHROMA_HOST=                        # only needed if CHROMA_MODE=server
CHROMA_PORT=                        # only needed if CHROMA_MODE=server
CHROMA_COLLECTION_NAME=sentinelrag_events

# ---------------------------
# Answer-Generation LLM (via LangGraph)
# Choose ONE provider and fill in only its key.
# ---------------------------
LLM_PROVIDER=anthropic              # anthropic | openai | google | local

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# If LLM_PROVIDER=local, point to a self-hosted inference endpoint (e.g. vLLM)
LOCAL_LLM_ENDPOINT=
LOCAL_LLM_MODEL_NAME=

# ---------------------------
# Security / Auth (optional, for multi-user or deployed demo)
# ---------------------------
JWT_SECRET_KEY=
JWT_EXPIRY_MINUTES=60

# ---------------------------
# CORS (only relevant once a frontend is deployed separately)
# ---------------------------
ALLOWED_ORIGINS=http://localhost:3000
