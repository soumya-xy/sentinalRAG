# ============================================================
# SentinelRAG — Environment Configuration Example
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.
# ============================================================

# ---------------------------
# App / Server Config
# ---------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
# json (default) or text. JSON includes request_id, video_id, and query_id on every line.
LOG_FORMAT=json

# ---------------------------
# Supabase (auth + storage + Postgres/pgvector)
# Project Settings → API
# ---------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only needed if you verify JWTs locally instead of auth.get_user.
# Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

SUPABASE_VIDEOS_BUCKET=videos
SUPABASE_THUMBNAILS_BUCKET=thumbnails
THUMBNAIL_SIGNED_URL_TTL_SECONDS=3600

# ---------------------------
# Frame Sampling Config
# ---------------------------
FRAME_SAMPLE_INTERVAL_SECONDS=0.8
USE_SCENE_CHANGE_DETECTION=false
EVENT_GAP_SECONDS=4.0
EVENT_MIN_BOX_AREA=400
EVENT_IOU_MIN=0.25

RETRIEVAL_TOP_K=3
RETRIEVAL_CANDIDATE_K=8
RETRIEVAL_MIN_SIMILARITY=0.48
RETRIEVAL_VECTOR_WEIGHT=0.60
RETRIEVAL_LEXICAL_WEIGHT=0.25
RETRIEVAL_CLASS_WEIGHT=0.10
RETRIEVAL_CONFIDENCE_WEIGHT=0.05

# ---------------------------
# Object Detection (YOLO11) — runs locally on CPU or GPU
# ---------------------------
YOLO_MODEL_NAME=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.4
YOLO_DEVICE=auto
YOLO_CLASS_FILTER=person,bicycle,car,motorcycle,bus,truck,backpack,handbag,suitcase,dog,cat

# ---------------------------
# Captioning
# ---------------------------
VLM_PROVIDER=gemini
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
VLM_INFERENCE_MODE=api
VLM_INFERENCE_ENDPOINT=
VLM_USE_RULE_BASED_FALLBACK=false
HUGGINGFACE_TOKEN=

# ---------------------------
# Embeddings (stored in Supabase pgvector, 768-d)
# ---------------------------
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL_NAME=BAAI/bge-m3
GOOGLE_EMBEDDING_MODEL=text-embedding-004
# Optional. Leave empty when the model id already includes the version (text-embedding-004).
EMBEDDING_MODEL_VERSION=
EMBEDDING_DIMENSIONS=768

# ---------------------------
# Answer-Generation LLM (via LangGraph)
# ---------------------------
LLM_PROVIDER=google

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_DELAY_SECONDS=1.0

LOCAL_LLM_ENDPOINT=
LOCAL_LLM_MODEL_NAME=

JWT_SECRET_KEY=
JWT_EXPIRY_MINUTES=60

ALLOWED_ORIGINS=http://localhost:3000
